# App Store Connect API key credentials for testflight-sample.sh.
# Copy this file to `.testflight.env` (same folder) and fill in your values.
# `.testflight.env` is gitignored — never commit real credentials.
#
# Where to get these: App Store Connect → Users and Access → Integrations →
# App Store Connect API → generate a key with "App Manager" (or higher) role.
#   - ASC_KEY_ID     = the key's Key ID (shown next to the key)
#   - ASC_ISSUER_ID  = the Issuer ID (shown at the top of the Keys page)
# Download the .p8 ONCE and put it at:
#   ~/.appstoreconnect/private_keys/AuthKey_<ASC_KEY_ID>.p8
# (or point ASC_KEY_PATH at it explicitly).

ASC_KEY_ID=XXXXXXXXXX
ASC_ISSUER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# ASC_KEY_PATH=/absolute/path/to/AuthKey_XXXXXXXXXX.p8
